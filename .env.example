# The BFR Pros - environment variables
# Copy to .env.local for local dev (gitignored), and set the same keys in Vercel.
#
# IMPORTANT: the /consulting AND /train-your-team forms save to Supabase WITHOUT
# any env vars. They use the publishable anon key (committed in
# src/lib/constants.ts) plus an INSERT-only RLS policy on the consulting_leads /
# clinic_inquiries tables, the standard, safe pattern for a public form (the
# public can submit; only you, via the Supabase dashboard, can read submissions).
# So everything below is OPTIONAL.

# --- Email notification to Nick (optional; Resend) ---
# If RESEND_API_KEY is unset, submissions still save to Supabase; no email is sent.
# The same RESEND_API_KEY is shared by both forms.
RESEND_API_KEY=
# *_NOTIFY_FROM must be a Resend-verified sender. Verify thebfrpros.com in Resend
# first (DNS records), then use e.g. consulting@thebfrpros.com. For a quick test
# before verifying a domain, use: BFR Pros <onboarding@resend.dev> (Resend's test
# sender only delivers to the Resend account owner's address.)
CONSULTING_NOTIFY_FROM=BFR Pros <consulting@thebfrpros.com>
CONSULTING_NOTIFY_TO=nick@thebfrpros.com
# /train-your-team qualify-form notifications (same rules as above).
TEAM_TRAINING_NOTIFY_FROM=BFR Pros <team@thebfrpros.com>
TEAM_TRAINING_NOTIFY_TO=nick@thebfrpros.com

# --- The Loading Wall opt-in page (REQUIRED for /the-loading-wall) ---
# /api/the-loading-wall upserts the subscriber into the MailerLite "The Loading
# Wall" group (which triggers the delivery automation). Both are server-side only
# and never shipped to the client bundle. Without them the form returns a clean
# error and shows the inline retry message. Set both in Vercel before go-live.
MAILERLITE_API_KEY=
MAILERLITE_LOADING_WALL_GROUP_ID=187160883924829781

# --- Optional hardening (only if you want to stop using the public anon key) ---
# If set, the /api/consulting + /api/team-training routes use these instead of the
# committed anon key.
# SUPABASE_SERVICE_ROLE_KEY is secret and server-only; never prefix with NEXT_PUBLIC.
# SUPABASE_URL=https://brvebfxaexxjghvwyidy.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
